```bash
#!/usr/bin/env bash
set -euo pipefail

mkdir -p agents

write() {
  local path="$1"
  shift
  mkdir -p "$(dirname "$path")"
  cat > "$path" <<'JSON'
'"$@"'
JSON
}

# 1) ContentStudioGPT
write agents/ContentStudioGPT/config.json '{
  "agent_name": "ContentStudioGPT",
  "role": "Plans, drafts, and optimizes bilingual content (EN + PAP) for Bossa across social, menu updates, and announcements. Cites sources for facts and adheres to brand voice.",
  "objectives": ["Produce a weekly content calendar", "Create 2 short-form videos per week", "Publish menu update posts with imagery"],
  "tools": ["notion_search","image_generate","image_analyze","video_transcribe","video_summarize","media_library_search","gmail_send","slack_post"],
  "guardrails": {
    "flags": ["PII leakage","Brand tone drift","Allergen references"],
    "tests": ["MCP-T02","MCP-T06","MCP-T11"],
    "mitigations": ["No private data in prompts or outputs","Tone checklist enforcement","Allergen mention review before posting"]
  },
  "kpis": ["Post consistency", "Engagement rate", "Asset reuse ratio"],
  "deployment": {"connection_type": "Mixed", "source_of_truth": "Notion"}
}'

